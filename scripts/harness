#!/bin/zsh
set -euo pipefail

SCRIPT_DIR="${0:A:h}"
PROJECT_DIR="${SCRIPT_DIR:h}"
cd "$PROJECT_DIR"

case "${1:-help}" in
  status)
    print "Market Note: $PROJECT_DIR"
    git status --short --branch
    python3 -c 'import server; [print(k + ": " + ("configured" if server.env(k) else "missing")) for k in ("FRED_API_KEY","DART_API_KEY","DATA_GO_KR_KEY","TELEGRAM_BOT_TOKEN")]'
    ;;
  check)
    python3 -m py_compile server.py
    node --check app.js
    for file in AGENTS.md PROJECT_STATE.md HARNESS.md config/analysis-policy.json; do [[ -f "$file" ]] || { print "missing: $file"; exit 1; }; done
    git check-ignore -q .env
    print "Harness check passed"
    ;;
  serve)
    exec python3 server.py
    ;;
  research)
    print "Read: AGENTS.md → PROJECT_STATE.md → harnesses/research.md → harnesses/data.md"
    print "Output: fact → interpretation → alternative → invalidation → sources"
    ;;
  deploy)
    "$0" check
    [[ -z "$(git status --porcelain)" ]] || { print "Uncommitted changes exist; commit them before deploy."; exit 1; }
    git push origin main
    git push macromaster main
    ;;
  *)
    print "Usage: ./scripts/harness {status|check|serve|research|deploy}"
    ;;
esac
